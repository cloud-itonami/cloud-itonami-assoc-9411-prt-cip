(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "europe") 3
      (string=? candidate "governance") 15
      (string=? candidate "labor") 5
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "europe") (cond
        (= i 0) (entry-field a 3 "id")
        (= i 1) (entry-field a 4 "id")
        (= i 2) (entry-field a 14 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 2 "id")
        (= i 3) (entry-field a 3 "id")
        (= i 4) (entry-field a 4 "id")
        (= i 5) (entry-field a 5 "id")
        (= i 6) (entry-field a 6 "id")
        (= i 7) (entry-field a 7 "id")
        (= i 8) (entry-field a 8 "id")
        (= i 9) (entry-field a 9 "id")
        (= i 10) (entry-field a 10 "id")
        (= i 11) (entry-field a 11 "id")
        (= i 12) (entry-field a 12 "id")
        (= i 13) (entry-field a 13 "id")
        (= i 14) (entry-field a 14 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "labor") (cond
        (= i 0) (entry-field a 6 "id")
        (= i 1) (entry-field a 9 "id")
        (= i 2) (entry-field a 11 "id")
        (= i 3) (entry-field a 12 "id")
        (= i 4) (entry-field a 13 "id")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] 
      "cloud-itonami-assoc-9411-prt-cip Wave 0 (ADR-2607141700): 15 CIP entries, each citing a source with the page and the verbatim span it rests on, across four voices: CIP itself, the statutory social-concertation body (CES), the European peak body, and an encyclopaedia. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
